{
  "schemaVersion": 1,
  "tracks": {
    "app": "平台函数的业务代码",
    "runtime": "腾讯云 SCF 基底：打包、层、内存、超时、入口、环境变量名、触发器。指纹里只有名字，没有变量值。",
    "user": "用户在自己站点上发布的函数。不得出现在 functions 里。"
  },
  "excluded": [
    {
      "name": "user-sites",
      "track": "user",
      "reason": "用户站点及其函数是第三条轨道，不进这份清单。"
    },
    {
      "name": "demox-website-api",
      "track": "rollback",
      "reason": "旧回滚函数，不再更新。"
    },
    {
      "name": "demox-auth-api",
      "track": "rollback",
      "reason": "旧回滚函数，不再更新。"
    },
    {
      "name": "demox-mcp-api",
      "track": "rollback",
      "reason": "旧回滚函数，不再更新。"
    },
    {
      "name": "demox-cert-renew",
      "track": "rollback",
      "reason": "旧回滚函数，不再更新。"
    }
  ],
  "functions": [
    {
      "name": "demox-function-api",
      "cloud": "tencent-scf",
      "region": "ap-guangzhou",
      "namespace": "demox",
      "accountEnv": "TENCENTCLOUD_ACCOUNT_UIN",
      "layer": "platform",
      "releaseVia": "deploy-develop",
      "appVersion": "0.1.12",
      "runtimeVersion": "0.1.0",
      "codePaths": [
        "scf-code/function-api",
        "scf-code/website-api",
        "scf-code/mcp-api",
        "scf-code/cert-renew",
        "scf-deploy-packages/auth-api"
      ],
      "runtimePaths": [
        "scripts/package-unified-scf.mjs",
        "scripts/ci/reproducible-zip.mjs",
        "scripts/ci/unified-scf-package-lock.json"
      ],
      "runtime": {
        "entry": "index.main",
        "memoryMB": 512,
        "timeoutSec": 300,
        "layers": [],
        "environmentNames": [
          "ACME_EMAIL",
          "ANALYTICS_HASH_SALT",
          "ANALYTICS_RAW_BUCKET_ID",
          "ANALYTICS_RAW_ENABLED",
          "AUTH_API_URL",
          "DEMOX_PLATFORM_WEBSITE_ID",
          "DEMOX_SITE_WEBSITE_ID",
          "EDGEONE_ZONE_ID",
          "ENCRYPTION_KEY",
          "FAIL_OPEN_CHECK_KEY",
          "FEISHU_APP_ID",
          "FEISHU_APP_SECRET",
          "FEISHU_REDIRECT_URI",
          "FUNCTIONS_COS_BUCKET",
          "FUNCTIONS_COS_REGION",
          "FUNCTIONS_NODE_RUNTIME",
          "FUNCTIONS_NODE_RUNTIME_URL",
          "FUNCTIONS_RUNTIME_NAMESPACE",
          "FUNCTION_ENV",
          "FUNCTION_PUBLIC_BASE_URL",
          "GITHUB_CLIENT_ID",
          "GITHUB_CLIENT_SECRET",
          "JWT_EXPIRES_IN",
          "JWT_SECRET",
          "MYSQL_DATABASE",
          "MYSQL_HOST",
          "MYSQL_PASSWORD",
          "MYSQL_PORT",
          "MYSQL_USER",
          "RENEW_THRESHOLD_DAYS",
          "RUNTIME_INVOKE_SECRET",
          "WEBSITE_API_URL"
        ],
        "triggers": [
          "http:api.demox.site",
          "timer:analytics-rollup-5m",
          "timer:monthly-renew"
        ],
        "asyncInvoke": {
          "retryNum": 0,
          "msgTtlSec": 21600,
          "api": "UpdateFunctionEventInvokeConfig",
          "qualifiers": ["production", "$LATEST"],
          "note": "定时器是 SCF 异步调用，默认 RetryNum=2，失败后一共跑 3 次。monthly-renew 每次重试都可能向 Let's Encrypt 新签发一张证书，所以重试次数固定为 0。这是函数级配置，analytics-rollup-5m 也不再自动重试。不计入配置指纹：CI 只换代码，不会调用 UpdateFunctionEventInvokeConfig。上线后续期之前要对列出的 qualifier 各调用一次；发布 app 的 CI 不会替线上改这项。"
        }
      }
    },
    {
      "name": "demox-user-nodejs",
      "cloud": "tencent-scf",
      "region": "ap-guangzhou",
      "namespace": "demox",
      "accountEnv": "TENCENTCLOUD_ACCOUNT_UIN",
      "layer": "platform",
      "releaseVia": "none",
      "note": "平台 Node 运行时池，由路由器内网调用。不是用户在自己站点上发布的函数。本 CI 不发布它。",
      "appVersion": "0.1.0",
      "runtimeVersion": "0.1.0",
      "codePaths": [
        "scf-code/function-api/runtime-nodejs.js",
        "scf-code/function-api/runtime-nodejs-handler.js",
        "scf-code/function-api/runtime-nodejs-worker.cjs"
      ],
      "runtimePaths": [
        "scripts/package-unified-scf.mjs",
        "scripts/ci/reproducible-zip.mjs",
        "scripts/ci/unified-scf-package-lock.json"
      ],
      "runtime": {
        "entry": "runtime-nodejs.main",
        "memoryMB": 512,
        "timeoutSec": 300,
        "layers": [],
        "environmentNames": [
          "FUNCTION_RUNTIME",
          "RUNTIME_INVOKE_SECRET"
        ],
        "triggers": [
          "http:internal"
        ]
      }
    }
  ]
}
